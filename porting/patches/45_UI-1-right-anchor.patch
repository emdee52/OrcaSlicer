diff --git a/src/slic3r/GUI/Gizmos/GLGizmoEdgeDress.cpp b/src/slic3r/GUI/Gizmos/GLGizmoEdgeDress.cpp
index aa217b13d7..7f727b1549 100644
--- a/src/slic3r/GUI/Gizmos/GLGizmoEdgeDress.cpp
