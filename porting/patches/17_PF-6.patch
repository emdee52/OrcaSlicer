+// [ORCAPORT FILE] gouraud_light_clip - clipped variant of gouraud_light used by the PF-6 preview clipping plane for shells
+#version 110
+
+uniform vec4 uniform_color;
+uniform float emission_factor;
+
+// x = tainted, y = specular;
