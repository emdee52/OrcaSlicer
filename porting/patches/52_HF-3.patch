-        return;
-    }
-
-    if (mo != m_old_object || int(mo->volumes.size()) != m_old_volume_count || instance_matrix().matrix() != m_old_matrix.matrix()) {
-        m_old_object       = mo;
-        m_old_volume_count = int(mo->volumes.size());
