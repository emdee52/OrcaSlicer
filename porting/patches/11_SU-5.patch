+const ModelObject *GLGizmoSupportZones::current_object() const
+{
+    const Model *model = m_parent.get_selection().get_model();
+    const int    idx   = current_object_idx();
+    if (model == nullptr || idx < 0 || idx >= int(model->objects.size()))
+        return nullptr;
