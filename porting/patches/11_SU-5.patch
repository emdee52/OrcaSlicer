+    draw_glyph(dl, ImVec2(a.x + 0.4f * u, a.y + (h - 0.8f * u) * 0.5f), 0.8f * u, Glyph::Warn, col);
+    dl->AddText(nullptr, 0.f, ImVec2(a.x + gut, a.y + 0.25f * u), col, text, nullptr, wrap);
+    if (why != nullptr && ImGui::IsItemHovered())
