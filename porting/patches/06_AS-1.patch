diff --git a/src/libslic3r/OrcaExt/FreeZ.cpp b/src/libslic3r/OrcaExt/FreeZ.cpp
new file mode 100644
index 0000000000..be3d2aba55
--- /dev/null
+++ b/src/libslic3r/OrcaExt/FreeZ.cpp
@@ -0,0 +1,23 @@
+#include "FreeZ.hpp"
+
+#include <atomic>
+
+namespace Slic3r {
+namespace OrcaExt {
+
+namespace {
+std::atomic<bool> s_free_z{ false };
+} // namespace
+
+void set_free_z(bool enabled)
+{
+    s_free_z.store(enabled, std::memory_order_relaxed);
+}
+
+bool free_z()
+{
+    return s_free_z.load(std::memory_order_relaxed);
+}
+
+} // namespace OrcaExt
+} // namespace Slic3r
diff --git a/src/libslic3r/OrcaExt/FreeZ.hpp b/src/libslic3r/OrcaExt/FreeZ.hpp
new file mode 100644
index 0000000000..799e8196bb
--- /dev/null
+++ b/src/libslic3r/OrcaExt/FreeZ.hpp
@@ -0,0 +1,19 @@
+#ifndef slic3r_OrcaExt_FreeZ_hpp_
+#define slic3r_OrcaExt_FreeZ_hpp_
+
+// [ORCAPORT:AS-1] App-level "free Z" placement preference.
+//
+// When enabled, the GUI stops force-snapping a moved object back down to the bed, so objects
+// can be floated in Z to align against each other without assembling them. Printing is done
+// after assembling, so this is placement-only: it never changes slicing.
+
+namespace Slic3r {
+namespace OrcaExt {
+
+void set_free_z(bool enabled);
+bool free_z();
+
+} // namespace OrcaExt
+} // namespace Slic3r
+
+#endif
