+void GLGizmoPerforation::rebuild_hover_highlight()
+{
+    m_face_highlight.reset();
+    if (m_hover_mv == nullptr || m_hover_region.empty())
+        return;
+    if (m_pick.valid && m_pick.mv == m_hover_mv && m_pick.facet == m_hover_facet)
+        return;
