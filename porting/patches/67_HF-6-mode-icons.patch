+// [ORCAPORT:HF-6] The two mode glyphs: the same part face, with the feature either standing out of it
+// (Extrude face) or closed flush in a recess cut into it (Cavity fill). The plate is the shared one -
+// gizmo_glyph_plate's rect, rounding and stroke - except that its top edge sits lower than 0.12 so the
+// boss has room to read as standing OUT: the shared rect leaves only 12 units of headroom above it,
+// which is 2.2 px at the real 28 px button.
+//
+// 🔑 The recess is a slot outline plus a plug that fills it flush, NOT a notch in the plate's
+// silhouette. A notch makes the plate's outline CONCAVE, and this ImGui (1.83) has no concave fill: the
+// plate would have to be tiled from convex pieces, and two adjacent 26% fills either leave a hairline of
+// the panel showing between them or double up into a darker seam (see the me_chamfer note in
+// GLGizmoHoles.cpp). The boss and the recess still share one footprint and one depth, mirrored about the
+// face's top edge.
+constexpr float EXTRUDE_GLYPH_FACE_TOP = 0.30f; // the face's top edge, of the glyph box
+constexpr float EXTRUDE_GLYPH_DEPTH    = 0.24f; // boss rise / recess depth, of the glyph box
+constexpr float EXTRUDE_GLYPH_FEATURE  = 0.40f; // feature width, of the plate side
+constexpr float EXTRUDE_GLYPH_ROUND    = 0.06f; // the plate's corner rounding
+
+// Appends `seg` + 1 points on the arc from a0 to a1 (degrees; screen axes have y down, so the order used
+// below runs clockwise, which is what ImGui's anti-aliased convex fill assumes).
+int glyph_arc(ImVec2 *out, int n, float cx, float cy, float r, float a0, float a1, int seg)
+{
+    for (int i = 0; i <= seg; ++i) {
+        const float a = float((a0 + (a1 - a0) * double(i) / double(seg)) * PI / 180.);
+        out[n++] = ImVec2(cx + r * std::cos(a), cy + r * std::sin(a));
+    }
+    return n;
+}
+
+void extrude_mode_glyph(ImDrawList *dl, const ImVec2 &p, float s, ImU32 col, bool recess)
+{
+    const float x0 = p.x + 0.12f * s, x1 = p.x + 0.88f * s;
+    const float top = p.y + EXTRUDE_GLYPH_FACE_TOP * s, bot = p.y + 0.88f * s;
+    const float r    = EXTRUDE_GLYPH_ROUND * s;
+    const float deep = EXTRUDE_GLYPH_DEPTH * s;
+    const float hw   = 0.5f * EXTRUDE_GLYPH_FEATURE * (x1 - x0);
+    const float fx0  = 0.5f * (x0 + x1) - hw, fx1 = 0.5f * (x0 + x1) + hw;
+
+    // The face itself: convex, so one fill and one closed outline.
+    ImVec2 pts[20];
+    int    n = 0;
+    n = glyph_arc(pts, n, x0 + r, top + r, r, 180.f, 270.f, 3); // top-left
+    n = glyph_arc(pts, n, x1 - r, top + r, r, 270.f, 360.f, 3); // top-right
+    n = glyph_arc(pts, n, x1 - r, bot - r, r, 0.f, 90.f, 3);    // bottom-right
+    n = glyph_arc(pts, n, x0 + r, bot - r, r, 90.f, 180.f, 3);  // bottom-left
+    dl->AddConvexPolyFilled(pts, n, (col & ~IM_COL32_A_MASK) | (66u << IM_COL32_A_SHIFT));
+    dl->AddPolyline(pts, n, col, ImDrawFlags_Closed, kGizmoGlyphStroke * s);
+
+    if (! recess) {
+        // The boss, standing on the face. Its foot reaches a hair past the top edge so the two fills
+        // merge instead of the face's own outline being drawn across it.
+        dl->AddRectFilled(ImVec2(fx0, top - deep), ImVec2(fx1, top + 0.03f * s), col);
+        return;
+    }
+
+    // The recess and its plug, flush with the top edge. The plug is solid inside a face that is only
+    // 26% ink, and the slot's outline is what makes it read as a recess rather than a raised block; the
+    // open path leaves the top edge uncrossed, which is the "closed flush" part.
+    const ImVec2 slot[4] = {ImVec2(fx0, top), ImVec2(fx0, top + deep), ImVec2(fx1, top + deep),
+                            ImVec2(fx1, top)};
+    dl->AddRectFilled(ImVec2(fx0, top), ImVec2(fx1, top + deep), col);
+    dl->AddPolyline(slot, 4, col, ImDrawFlags_None, kGizmoGlyphStroke * s);
+}
+
+void extrude_face_glyph(ImDrawList *dl, const ImVec2 &p, float s, ImU32 col)
+{
+    extrude_mode_glyph(dl, p, s, col, false);
+}
+
+void cavity_fill_glyph(ImDrawList *dl, const ImVec2 &p, float s, ImU32 col)
+{
+    extrude_mode_glyph(dl, p, s, col, true);
+}
