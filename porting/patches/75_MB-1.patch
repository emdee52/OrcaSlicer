+    // Only a MODEL PART aimed at the source slot reaches here.
+    m_src.trafo      = trafo;
+    m_src.volume_idx = volume_idx;
+    set_src_volume(mv);
+    m_selecting_state = MeshBooleanSelectingState::SelectTool;
+}
