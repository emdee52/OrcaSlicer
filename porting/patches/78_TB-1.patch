+++    CHECK_THAT(std::abs(a90.to_obj.linear().col(0).y()), WithinAbs(1., 1e-9));
+++    CHECK_THAT(a90.to_obj.linear().col(2).z(), WithinAbs(1., 1e-9));
+++    CHECK_THAT(a90.to_obj.linear().col(0).dot(a0.to_obj.linear().col(0)), WithinAbs(0., 1e-9));
