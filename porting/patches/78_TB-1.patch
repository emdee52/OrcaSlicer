++++
++++    nlohmann::json names = nlohmann::json::array();
++++    for (int i = 0; i < g.standard_count(); ++i)
++++        names.push_back(g.standard_name(i));
++++
++++    nlohmann::json result = {
++++        {"anchored", g.anchor_valid()},
++++        {"shape", shape},
++++        {"root_w", g.get_root_w()},
++++        {"root_len", g.get_root_len()},
++++        {"tip_len", g.get_tip_len()},
