++++// ---------------------------------------------------------------------------------------------
++++// The hover, the anchor and the tab's frame
++++// ---------------------------------------------------------------------------------------------
++++
++++void GLGizmoTabs::clear_hover()
++++{
++++    m_hover         = Hover();
++++    m_preview_dirty = true;
++++    m_preview_face.reset();
++++}
++++
++++void GLGizmoTabs::update_hover(const Vec2d &screen_pos)
++++{
++++    const Hover previous = m_hover;
++++    m_hover              = Hover();
++++
++++    const ModelObject *mo = model_object();
++++    if (mo != nullptr) {
++++        const ClippingPlane *clipping = m_c != nullptr && m_c->object_clipper() != nullptr
++++                                            ? m_c->object_clipper()->get_clipping_plane()
++++                                            : nullptr;
++++        const GLVolume    *volume = nullptr;
++++        const ModelVolume *mv     = nullptr;
++++        size_t             facet  = 0;
++++        Vec3d              hit_world;
++++        // The tabs already added are picked THROUGH: they sit on the surface, and a committed tab must
++++        // not stop the next one from being placed beside it.
++++        if (raycast_object_face(screen_pos, m_parent.get_selection(), mo, clipping, volume, mv, facet, hit_world,
++++                                [](const ModelVolume *v) { return !is_tab_volume(v); })) {
++++            if (mv != nullptr && facet < mv->mesh().its.indices.size()) {
++++                m_hover.valid   = true;
++++                m_hover.mv      = mv;
++++                m_hover.facet   = int(facet);
++++                m_hover.hit_obj = instance_matrix().inverse() * hit_world;
++++            }
++++        }
++++    }
++++
++++    if (m_hover.valid != previous.valid
++++        || (m_hover.valid && (m_hover.mv != previous.mv || m_hover.facet != previous.facet
++++                              || (m_hover.hit_obj - previous.hit_obj).norm() > 1e-6)))
++++        m_preview_dirty = true;
++++}
++++
++++Transform3d GLGizmoTabs::frame_to_obj() const
++++{
++++    Transform3d t = Transform3d::Identity();
++++    if (!m_pick.valid)
++++        return t;
++++    const double a = deg2rad(m_angle);
++++    const Vec3d  u = m_pick.u_obj * std::cos(a) + m_pick.v_obj * std::sin(a);
++++    const Vec3d  v = -m_pick.u_obj * std::sin(a) + m_pick.v_obj * std::cos(a);
++++    t.linear().col(0) = u;
++++    t.linear().col(1) = v;
++++    t.linear().col(2) = m_pick.normal_obj;
++++    t.translation()   = m_pick.anchor_obj;
++++    return t;
++++}
++++
++++Transform3d GLGizmoTabs::frame_to_volume(const ModelVolume *mv) const
++++{
++++    return mv == nullptr ? frame_to_obj() : mv->get_matrix().inverse() * frame_to_obj();
++++}
++++
++++double GLGizmoTabs::default_angle() const
++++{
++++    if (!m_pick.valid)
++++        return 0.;
++++    // Away from the object's own centre, so the tab hangs off the nearest edge instead of lying on
++++    // the middle of the face - which is what a mounting tab is for.
++++    Vec3d out = m_pick.anchor_obj - object_centre();
++++    out -= m_pick.normal_obj * out.dot(m_pick.normal_obj);
++++    if (out.norm() < 1e-6)
++++        return 0.;
++++    out.normalize();
++++    double a = std::atan2(out.dot(m_pick.v_obj), out.dot(m_pick.u_obj)) * 180. / PI;
++++    if (a < 0.)
++++        a += 360.;
++++    return a;
++++}
++++
++++bool GLGizmoTabs::anchor_at(const Vec2d &screen_pos)
++++{
++++    update_hover(screen_pos);
++++    if (!m_hover.valid || m_hover.mv == nullptr || m_hover.facet < 0)
++++        return false;
++++
++++    Vec3d n = facet_normal_in_world(m_hover.mv->mesh().its, m_hover.facet, m_hover.mv->get_matrix());
++++    if (!n.allFinite() || n.norm() < 1e-9)
++++        return false;
++++    n.normalize();
++++
++++    Pick p;
++++    p.valid      = true;
++++    p.mv         = m_hover.mv;
++++    p.facet      = m_hover.facet;
++++    p.anchor_obj = m_hover.hit_obj;
++++    p.normal_obj = n;
++++    // The frame's own tangents: the world axis least parallel to the normal, projected into the face.
++++    const Vec3d ref = std::abs(n.dot(Vec3d::UnitX())) < 0.9 ? Vec3d::UnitX() : Vec3d::UnitY();
++++    p.u_obj         = (ref - n * ref.dot(n)).normalized();
++++    p.v_obj         = n.cross(p.u_obj).normalized();
++++
++++    m_pick          = p;
++++    m_angle         = default_angle();
++++    m_merged_dirty  = true;
++++    m_preview_dirty = true;
++++    probe_surface(true);
++++    m_parent.set_as_dirty();
++++    return true;
++++}
++++
++++void GLGizmoTabs::clear_anchor()
++++{
++++    if (!m_pick.valid)
++++        return;
++++    m_pick          = Pick();
++++    m_probe         = TabSurfaceProbe();
++++    m_effective_bite = m_bite;
++++    m_why.clear();
++++    m_preview_dirty = true;
++++    m_parent.set_as_dirty();
++++}
