+void GLGizmoTabs::set_hole_offset(double mm)
+{
+    // The hole slides INSIDE the tab: the outline stays where Length put it, and the bounds come from
+    // the tab's own ends.
+    m_hole_offset   = std::clamp(mm, hole_offset_min(), hole_offset_max());
+    probe_surface(true);
