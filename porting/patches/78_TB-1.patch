+TEST_CASE("A slot with no room for prongs is refused", "[TabShapes]")
+{
+    TabSpec s = tab_12deg();
+    s.passage   = TabPassage::Slot;
+    s.taper_deg = 60.; // collapses the tip to the smallest radius a round tip may keep
+
